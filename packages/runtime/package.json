{
  "name": "@taut/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./machine": "./src/machine/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./browser": "./src/browser.ts",
    "./redact": "./src/redact.ts",
    "./repos": "./src/repos.ts",
    "./instructions": "./src/instructions.ts",
    "./run": "./src/run.ts"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
