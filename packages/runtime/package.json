    "clean": "rm -rf .turbo node_modules .eslintcache"
  },
  "dependencies": {
    "@playwright/mcp": "0.0.80",
    "@taut/contract": "workspace:*",
    "dockerode": "5.0.1",
    "effect": "3.22.1",
    "tar-stream": "3.2.1"
  },
  "devDependencies": {
    "@effect/vitest": "0.30.0",
    "@taut/eslint-config": "workspace:*",
    "@taut/typescript-config": "workspace:*",
    "@types/dockerode": "4.0.1",
    "@types/node": "22.20.1",
    "@types/tar-stream": "3.1.4",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "vitest": "3.2.7"
  }
}
