# Copy to .env (never committed). All variables are optional in development.

# HTTP + WebSocket port of @taut/server.
PORT=3000

# Where SQLite (taut.db), company folders and the dev master key live. Back up = copy this dir.
TAUT_DATA_DIR=./data

# 32 random bytes, base64. REQUIRED when NODE_ENV=production; in development one is
# generated into $TAUT_DATA_DIR/master.key (mode 0600) and reused.
#   openssl rand -base64 32
TAUT_MASTER_KEY=

# Set the Secure flag on the session cookie. Defaults to true when NODE_ENV=production.
# TAUT_COOKIE_SECURE=false

# Built web client served at / with SPA fallback. Defaults to apps/web/dist.
# TAUT_WEB_DIST=

# ── Agent execution (Phase 4) ──────────────────────────────────────────────────
# Where agent runtimes run: `local` spawns on this host (dev), `docker` = one container per agent.
TAUT_MACHINE_PROVIDER=local

# The server URL as seen from an agent's machine (TAUT_URL for the taut MCP server).
# Defaults to http://127.0.0.1:<PORT> (local) or http://host.docker.internal:<PORT> (docker).
# TAUT_PUBLIC_URL=

# Company-wide cap on concurrently running agent tasks (per agent it is always 1).
TAUT_MAX_CONCURRENT_TASKS=4

# Stream a short "(using tool X)" line into the reply for every tool call.
TAUT_SHOW_TOOLS=false

# Docker image for agent machines (docker provider only). Default: taut/agent:latest.
# TAUT_AGENT_IMAGE=

# DEV ONLY. When true and a company has no usable claude-code subscription, run `claude` with
# THIS host user's login instead of failing. Never enable in production.
TAUT_DEV_HOST_LOGIN=false

# Command that starts the taut MCP server inside the machine. Defaults to the built
# packages/taut-mcp/dist/mcp.js (local) or `node /opt/taut/mcp.js` (docker).
# TAUT_MCP_COMMAND=

# ── PWA / Web Push (Phase 8) ───────────────────────────────────────────────────
# VAPID keypair. Push notifications stay OFF (and the UI hides the toggle) unless both
# are set. Generate a pair with:
#   pnpm --filter @taut/server exec node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is handed to browsers; the private key must never leave the server.
# TAUT_VAPID_PUBLIC_KEY=
# TAUT_VAPID_PRIVATE_KEY=

# Contact the push services can reach about this deployment (mailto: or https:).
# TAUT_VAPID_SUBJECT=mailto:admin@example.com

# ── Calls / huddles ─────────────────────────────────────────────────────────────
# Self-hosted LiveKit + Redis + eturnal, behind the `calls` compose profile
# (docker compose --profile calls up -d). Calls stay OFF and the UI hides the
# huddle button unless TAUT_LIVEKIT_URL, TAUT_LIVEKIT_API_KEY and
# TAUT_LIVEKIT_API_SECRET are all set.

# wss://... as the *browser* must reach LiveKit. Not the internal URL below.
# TAUT_LIVEKIT_URL=

# LiveKit API key/secret pair, minted once and shared by the `livekit` container
# and @taut/server. Compose substitutes both into the `livekit` config block it renders.
#   openssl rand -hex 32
# TAUT_LIVEKIT_API_KEY=
# TAUT_LIVEKIT_API_SECRET=

# http(s):// the server uses to reach LiveKit directly, container-to-container.
# In docker-compose.yml this is already set to http://livekit:7880 for you.
# TAUT_LIVEKIT_INTERNAL_URL=

# Shared secret and reachable address for the `eturnal` TURN server. Same secret
# goes into the rendered LiveKit config's rtc.turn_servers so LiveKit can mint TURN
# credentials that eturnal will accept.
#   openssl rand -hex 32
# TAUT_TURN_SECRET=
# TAUT_TURN_HOST=turn.example.com
# TAUT_TURN_PUBLIC_IP=203.0.113.4

# Per-huddle participant cap and how long a minted join token stays valid.
# TAUT_CALL_MAX_PARTICIPANTS=30
# TAUT_CALL_TOKEN_TTL_SECONDS=21600
