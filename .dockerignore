# Everything here is rebuilt inside the image or is irrelevant to it.
**/node_modules
**/dist
**/out
**/.turbo
**/.vite
**/.vite-temp
**/.eslintcache
**/*.tsbuildinfo

.git
.github
.vscode

# Runtime state: SQLite, dev master key, company folders. Lives in the volume.
data
.env
.env.*
!.env.example

# Not part of the server image.
docs/research
apps/desktop
# …but the workspace manifest must exist or --frozen-lockfile rejects the tree.
!apps/desktop/package.json

**/.DS_Store
**/*.log
Dockerfile
.dockerignore
docker-compose.yml

# Private developer state and indexes are never build inputs.
.codegraph
.cursor
.codex
**/data
**/.env
**/.env.*
**/master.key
**/*.db
**/*.db-wal
**/*.db-shm
self-hosted
# Installer secrets must stay out even when its directory is inside the source checkout.
**/secrets.env
**/turn.env
**/livekit.yaml
**/installation.json
**/compose.json
**/backup-*.tar.gz
# Infrastructure state and signing credentials are never image build inputs.
**/.terraform
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/*.tfvars
**/*.tfvars.json
**/*.p12
**/*.p8
