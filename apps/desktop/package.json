{
  "name": "@taut/desktop",
  "version": "1.0.0",
  "productName": "Taut",
  "private": true,
  "description": "Taut desktop app (Electron + React + Tailwind + shadcn/ui)",
  "main": "./out/main/index.js",
  "author": "Taut",
  "scripts": {
    "dev": "electron-vite dev --config electron.vite.config.ts",
    "start": "electron-vite preview --config electron.vite.config.ts",
    "build": "electron-vite build --config electron.vite.config.ts",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "clean": "rm -rf out dist .turbo node_modules .eslintcache",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "package": "pnpm run build && electron-builder --config electron-builder.unsigned.yml --mac --dir --publish never",
    "package:mac": "node scripts/package-mac.mjs --unsigned",
    "release:mac": "node scripts/package-mac.mjs --release",
    "test:release": "node --test scripts/package-mac.test.mjs scripts/prepare-release.test.mjs",
    "test:updater": "node --test scripts/updater.test.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@taut/contract": "workspace:*",
    "@taut/ui": "workspace:*",
    "effect": "3.22.1",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@taut/eslint-config": "workspace:*",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "js-yaml": "^4.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "license": "MIT"
}
