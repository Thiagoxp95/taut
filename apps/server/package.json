{
  "name": "@taut/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint --cache .",
    "seed": "tsx src/seed.ts",
    "clean": "rm -rf dist .turbo node_modules .eslintcache"
  },
  "dependencies": {
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "@effect/sql": "0.52.1",
    "@effect/sql-sqlite-node": "0.53.0",
    "@taut/contract": "workspace:*",
    "@taut/memory": "workspace:*",
    "@taut/runtime": "workspace:*",
    "@taut/taut-mcp": "workspace:*",
    "dockerode": "5.0.1",
    "effect": "3.22.1",
    "livekit-server-sdk": "2.19.0",
    "web-push": "3.6.7",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@effect/vitest": "0.30.0",
    "@taut/eslint-config": "workspace:*",
    "@taut/typescript-config": "workspace:*",
    "@types/node": "^22.19.1",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "eslint": "^9.39.1",
    "http_ece": "1.2.0",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "vitest": "3.2.7"
  }
}
